# EcoTrack AI - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ============================================
# MONGODB DATABASE
# ============================================
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority"
# Note: URL-encode special characters in password (e.g., @ becomes %40)

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
# Generate with: openssl rand -hex 32
JWT_SECRET="your-jwt-secret-key-change-in-production"
NEXTAUTH_SECRET="your-nextauth-secret-key-change-in-production"

# ============================================
# APPLICATION URLS
# ============================================
# Development
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BACKEND_URL="http://127.0.0.1:8000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000/api"
NEXT_PUBLIC_APP_NAME="EcoTrack AI"

# Production (Docker/Nginx)
# NEXTAUTH_URL="https://yourdomain.com"
# NEXT_PUBLIC_BACKEND_URL="/backend"

# ============================================
# AI & ML SERVICES
# ============================================
# Perplexity AI (image classification)
PERPLEXITY_API_KEY="pplx-your-api-key"

# Groq (chat/LLM)
GROQ_API_KEY="gsk_your-groq-api-key"

# OpenAI (optional)
OPENAI_API_KEY=""

# ============================================
# CLOUD STORAGE
# ============================================
# Cloudinary (image uploads)
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# AWS S3 (alternative)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""

# ============================================
# EMAIL SERVICE
# ============================================
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT="587"
SENDER_EMAIL="your-email@gmail.com"
SENDER_PASSWORD="your-app-password"
# For Gmail: generate app password at https://myaccount.google.com/apppasswords

# ============================================
# CORS & NETWORKING
# ============================================
# Comma-separated list of allowed frontend origins
FRONTEND_ORIGINS="http://localhost,http://localhost:3000,http://localhost:3001"

# ============================================
# OPTIONAL SERVICES
# ============================================
CARBON_INTERFACE_API_KEY=""
GOOGLE_ANALYTICS_ID=""

# ============================================
# DATABASE (LEGACY/OPTIONAL)
# ============================================
DATABASE_URL="postgresql://user:password@localhost:5432/ecotrack"
POSTGRES_PASSWORD="your-postgres-password"

# ============================================
# ENVIRONMENT
# ============================================
NODE_ENV="development"

PERPLEXITY_API_KEY=

# Cloudinary (optional) - format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Groq fallback (if you still want to use Groq model)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VERIFY_MODEL=

# Debug / environment
NODE_ENV=development

# Notes: Fill in real secrets in your local `.env.local`. Never commit real keys to source control.